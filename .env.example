# Base URL for the backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# === Auth (backend/internal/auth/config.go) ===
# Способ отправки писем с кодами: smtp (Gmail SMTP, дефолт) | sendgrid | gmailapi
MAIL_PROVIDER=smtp

# Отправитель писем с кодами входа (обязателен для всех способов)
GMAIL_ADDRESS=example@gmail.com
# app-пароль Gmail — нужен только для MAIL_PROVIDER=smtp
GMAIL_APP_PASSWORD=example-app-password
# ярлык пароля в аккаунте Google — кодом не используется
GMAIL_APP_NAME=example-app-name

# SMTP-сервер (дефолты в коде: smtp.gmail.com:587; нужен только для smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Сроки жизни токенов сессии (дефолты в коде: 240h и 720h)
SESSION_ACCESS_TTL=240h
SESSION_REFRESH_TTL=720h

# SendGrid (Twilio) — нужен только для MAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# Gmail API — нужны все три для MAIL_PROVIDER=gmailapi (scope: gmail.send)
# GMAIL_API_CLIENT_ID=
# GMAIL_API_CLIENT_SECRET=
# GMAIL_API_REFRESH_TOKEN=
